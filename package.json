{
  "name": "glossa",
  "productName": "Glossa",
  "version": "1.0.0",
  "private": true,
  "description": "An invisible speech coach in your corner: offline, private, open source.",
  "license": "Apache-2.0",
  "author": "The Glossa Authors",
  "homepage": "https://github.com/Shreya20002/glossa",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Shreya20002/glossa.git"
  },
  "bugs": "https://github.com/Shreya20002/glossa/issues",
  "main": "./out/main/index.js",
  "engines": {
    "node": ">=22.12.0"
  },
  "packageManager": "pnpm@10.34.7",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "build:unpack": "electron-vite build && electron-builder --dir",
    "build:installer": "electron-vite build && electron-builder --publish never",
    "preview": "electron-vite preview",
    "fetch-models": "node scripts/fetch-models.mjs",
    "icon": "electron scripts/render-icon.mjs",
    "typecheck": "tsc --noEmit --composite false -p tsconfig.node.json && tsc --noEmit --composite false -p tsconfig.web.json && tsc --noEmit --composite false -p tsconfig.e2e.json",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "electron-vite build && playwright test",
    "eval": "vitest run --config eval/vitest.config.mts",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@types/node": "^24.9.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "^44.9.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^6.0.0",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  },
  "pnpm": {
    "overrides": {
      "sharp": "file:./stubs/sharp"
    },
    "ignoredBuiltDependencies": [
      "electron-winstaller",
      "onnxruntime-node",
      "protobufjs"
    ]
  },
  "dependencies": {
    "@huggingface/transformers": "^4.3.1",
    "onnxruntime-node": "^1.30.0"
  }
}
