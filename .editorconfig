# .editorconfig — basic formatting rules most code editors follow automatically
# (VS Code needs the "EditorConfig" extension). See https://editorconfig.org
root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 2
insert_final_newline = true
trim_trailing_whitespace = true

[*.md]
# Two trailing spaces mean "line break" in Markdown, so keep them.
trim_trailing_whitespace = false
