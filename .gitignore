# .gitignore — files git should NEVER track.
# Rule of thumb: ignore anything that is generated, downloaded, or secret.

# Dependencies (re-created by `pnpm install`)
node_modules/

# Build output (re-created by `pnpm build`)
out/
dist/
release/

# AI model files (downloaded by `pnpm fetch-models`; too big for git)
models/

# Test and coverage reports
coverage/
test-results/
playwright-report/

# Logs
*.log
npm-debug.log*
pnpm-debug.log*

# Secrets and local environment overrides — never commit these
.env
.env.*
!.env.example

# Editor and OS clutter
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/
.DS_Store
Thumbs.db
desktop.ini
