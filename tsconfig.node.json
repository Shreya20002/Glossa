{
  // Code that runs in Node.js: the Electron main process, the engine, preload
  // scripts, and build/test config files. (End-to-end tests: tsconfig.e2e.json.)
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2023"],
    "types": ["node"],
    "tsBuildInfoFile": "./node_modules/.cache/tsconfig.node.tsbuildinfo"
  },
  "include": [
    "electron.vite.config.ts",
    "vitest.config.mts",
    "src/main/**/*",
    "src/preload/**/*",
    "src/engine/**/*",
    "src/shared/**/*",
    "src/core/**/*"
  ]
}
